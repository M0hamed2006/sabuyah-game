#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# صابويه - لعبة الركض المصرية
# ملف التثبيت والتشغيل الشامل
# ═══════════════════════════════════════════════════════════════

echo "🎮 مرحباً بك في لعبة صابويه!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ==================== الخطوة 1: التحقق من البيئة ====================
echo -e "\n📋 التحقق من البيئة..."

# التحقق من وجود Python
if command -v python3 &> /dev/null; then
    echo "✅ Python3 متوفر"
    PYTHON_CMD="python3"
elif command -v python &> /dev/null; then
    echo "✅ Python متوفر"
    PYTHON_CMD="python"
else
    echo "⚠️ Python غير مثبت"
    echo "📥 يرجى تثبيت Python من: https://www.python.org"
fi

# ==================== الخطوة 2: إنشاء المجلد ====================
echo -e "\n📁 إعداد المجلد..."

PROJECT_DIR="sabuyah-advanced"
if [ -d "$PROJECT_DIR" ]; then
    echo "⚠️ المجلد موجود بالفعل"
else
    mkdir -p "$PROJECT_DIR"
    echo "✅ تم إنشاء المجلد: $PROJECT_DIR"
fi

cd "$PROJECT_DIR"

# ==================== الخطوة 3: التحقق من الملفات ====================
echo -e "\n✓ التحقق من الملفات المطلوبة..."

FILES_NEEDED=(
    "index.html"
    "style.css"
    "game.js"
    "soundGenerator.js"
    "README.md"
)

for file in "${FILES_NEEDED[@]}"; do
    if [ -f "$file" ]; then
        echo "✅ $file موجود"
    else
        echo "❌ $file غير موجود - يرجى نسخ الملفات"
    fi
done

# ==================== الخطوة 4: بدء الخادم ====================
echo -e "\n🚀 بدء الخادم..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ -z "$PYTHON_CMD" ]; then
    echo "⚠️ لا يمكن بدء الخادم - Python غير مثبت"
    echo "🎯 يمكنك فتح index.html مباشرة في المتصفح"
    echo "📂 الملف: $PWD/index.html"
else
    echo "🌐 سيتم فتح اللعبة على: http://localhost:8000"
    echo "⏹️  اضغط Ctrl+C لإيقاف الخادم"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    # فتح المتصفح إذا أمكن
    if command -v xdg-open &> /dev/null; then
        xdg-open http://localhost:8000 &
    elif command -v open &> /dev/null; then
        open http://localhost:8000 &
    fi
    
    # بدء الخادم
    $PYTHON_CMD -m http.server 8000
fi

exit 0
